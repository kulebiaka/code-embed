{
  "name": "code-embed",
  "version": "0.1.0",
  "description": "Local hybrid (semantic + lexical) code search",
  "keywords": [
    "code-search",
    "semantic-search",
    "embeddings",
    "hybrid-search",
    "mcp",
    "cli",
    "bm25",
    "sqlite"
  ],
  "homepage": "https://github.com/kulebiaka/code-embed#readme",
  "bugs": {
    "url": "https://github.com/kulebiaka/code-embed/issues"
  },
  "type": "module",
  "license": "MIT",
  "bin": {
    "code-embed": "dist/cli.js"
  },
  "files": [
    "dist/cli.js",
    "dist/grammars",
    "dist/tree-sitter.wasm"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kulebiaka/code-embed.git",
    "directory": "packages/engine"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc -p . --noEmit",
    "build": "node scripts/build.mjs",
    "dev": "tsx src/cli/main.ts"
  },
  "dependencies": {
    "@code-embed/protocol": "workspace:*",
    "@huggingface/transformers": "^4.3.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@napi-rs/keyring": "^2.1.0",
    "@parcel/watcher": "^2.6.0",
    "env-paths": "^4.0.0",
    "hash-wasm": "^4.12.0",
    "ignore": "^7.0.12",
    "onnxruntime-node": "1.30.0",
    "picomatch": "^4.0.7",
    "smol-toml": "^1.9.1",
    "sqlite-vec": "0.1.9",
    "tar": "^7.5.22",
    "tree-sitter-wasms": "0.1.13",
    "undici": "^7.30.0",
    "vscode-jsonrpc": "^9.0.3",
    "web-tree-sitter": "0.25.10",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/picomatch": "^4.0.3"
  }
}
